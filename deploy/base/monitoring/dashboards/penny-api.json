{
  "title": "Penny API",
  "uid": "penny-api",
  "description": "What users feel: can they load their schedule, and how fast. Source: penny_http_* and penny_db_pool_* from the API's /metrics.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["penny"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(penny_http_requests_total, namespace)",
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability (non-5xx share, 30 days)",
      "description": "SLO: 99.0% monthly.",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.99 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum(increase(penny_http_requests_total{namespace=\"$namespace\", code=~\"5..\", route!~\"GET /(livez|readyz)\"}[30d])) / sum(increase(penny_http_requests_total{namespace=\"$namespace\", route!~\"GET /(livez|readyz)\"}[30d])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Read latency p95 (1 hour)",
      "description": "SLO: under 300 ms for GET routes.",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.3 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(penny_http_request_duration_seconds_bucket{namespace=\"$namespace\", method=\"GET\", route!~\"GET /(livez|readyz)\"}[1h])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pods ready",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{namespace=\"$namespace\", job=~\".*penny-api.*\"} == 1)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Database connections in use",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(penny_db_pool_acquired_connections{namespace=\"$namespace\"}) / sum(penny_db_pool_max_connections{namespace=\"$namespace\"})"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests per second by route",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{route}}",
          "expr": "sum by (route) (rate(penny_http_requests_total{namespace=\"$namespace\"}[5m]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Errors per second by status",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{code}} {{route}}",
          "expr": "sum by (code, route) (rate(penny_http_requests_total{namespace=\"$namespace\", code=~\"[45]..\"}[5m]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latency p50 and p95 by route",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p95 {{route}}",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(penny_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[5m])))"
        },
        {
          "refId": "B",
          "legendFormat": "p50 {{route}}",
          "expr": "histogram_quantile(0.5, sum by (le, route) (rate(penny_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[5m])))"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Connection pool",
      "description": "Waiting acquires mean the pool is too small or queries are slow.",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "in use {{pod}}",
          "expr": "penny_db_pool_acquired_connections{namespace=\"$namespace\"}"
        },
        {
          "refId": "B",
          "legendFormat": "idle {{pod}}",
          "expr": "penny_db_pool_idle_connections{namespace=\"$namespace\"}"
        },
        {
          "refId": "C",
          "legendFormat": "waits/s {{pod}}",
          "expr": "rate(penny_db_pool_empty_acquires_total{namespace=\"$namespace\"}[5m])"
        }
      ]
    }
  ]
}
