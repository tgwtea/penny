{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "timezone": "Asia/Singapore",
  "schedule": ["before 9am on monday"],
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "One weekly PR for GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "One weekly PR for the pinned toolchain",
      "matchManagers": ["mise"],
      "groupName": "toolchain"
    },
    {
      "description": "One weekly PR for container images",
      "matchManagers": ["docker-compose", "dockerfile"],
      "groupName": "container images"
    },
    {
      "description": "One weekly PR for Go modules",
      "matchManagers": ["gomod"],
      "groupName": "go modules"
    },
    {
      "description": "One weekly PR for Dart and Flutter packages",
      "matchManagers": ["pub"],
      "groupName": "dart packages"
    },
    {
      "description": "Major versions get their own PR and need a human look",
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "dependencyDashboardApproval": true
    }
  ]
}
